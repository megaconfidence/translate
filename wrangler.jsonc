/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "translate",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-21",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Only /api/* reaches the Worker. Everything else is served straight
		// from the asset store, so the UI never pays for a Worker invocation.
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		// Non-secret config. The OCR model must be v4+ for `include_blocks`,
		// which is what gives us the bounding boxes the overlay is built on.
		"OCR_MODEL": "mistral-ocr-latest",
		"TRANSLATE_MODEL": "mistral-small-latest"
	},
	"secrets": {
		// Loaded from .env for `wrangler dev`; set with `wrangler secret put` to deploy.
		"required": ["MISTRAL_API_KEY"]
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.1 }
	},
	"upload_source_maps": true
}
